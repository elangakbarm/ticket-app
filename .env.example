NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_app?schema=public
JWT_ACCESS_SECRET=replace-with-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
BOOKING_HOLD_MINUTES=10
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
SWAGGER_ENABLED=true
