generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  OPERATOR
}

enum TrainClass {
  ECONOMY
  BUSINESS
  EXECUTIVE
}

enum ScheduleStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  ARRIVED
  DELAYED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum BookingItemStatus {
  HELD
  BOOKED
  RELEASED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  CREDIT_CARD
  E_WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

enum IdentityType {
  KTP
  PASSPORT
  OTHER
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

model User {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @default(uuid()) @map("public_id")
  fullName     String    @map("full_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  phoneNumber  String?   @map("phone_number")
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")

  refreshTokens RefreshToken[]
  bookings      Booking[]
  auditLogs     AuditLog[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Station {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid()) @map("public_id")
  code      String    @unique
  name      String
  city      String
  province  String
  address   String?
  timezone  String    @default("Asia/Jakarta")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  originRoutes      Route[] @relation("OriginStation")
  destinationRoutes Route[] @relation("DestinationStation")

  @@index([code])
  @@map("stations")
}

model Route {
  id                     Int       @id @default(autoincrement())
  publicId               String    @unique @default(uuid()) @map("public_id")
  routeCode              String    @unique @map("route_code")
  originStationId        Int       @map("origin_station_id")
  destinationStationId   Int       @map("destination_station_id")
  distanceKm             Decimal   @map("distance_km") @db.Decimal(10, 2)
  estimatedDurationMinutes Int     @map("estimated_duration_minutes")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  originStation      Station    @relation("OriginStation", fields: [originStationId], references: [id])
  destinationStation Station    @relation("DestinationStation", fields: [destinationStationId], references: [id])
  schedules          Schedule[]

  @@index([originStationId])
  @@index([destinationStationId])
  @@map("routes")
}

model Train {
  id         Int        @id @default(autoincrement())
  publicId   String     @unique @default(uuid()) @map("public_id")
  trainCode  String     @unique @map("train_code")
  name       String
  trainClass TrainClass @map("train_class")
  totalSeats Int        @map("total_seats")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  seats     Seat[]
  schedules Schedule[]

  @@map("trains")
}

model Seat {
  id             Int        @id @default(autoincrement())
  publicId       String     @unique @default(uuid()) @map("public_id")
  trainId        Int        @map("train_id")
  carriageNumber Int        @map("carriage_number")
  seatNumber     String     @map("seat_number")
  seatClass      TrainClass @map("seat_class")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  train        Train         @relation(fields: [trainId], references: [id])
  bookingItems BookingItem[]
  tickets      Ticket[]

  @@unique([trainId, carriageNumber, seatNumber])
  @@map("seats")
}

model Schedule {
  id            Int            @id @default(autoincrement())
  publicId      String         @unique @default(uuid()) @map("public_id")
  scheduleCode  String         @unique @map("schedule_code")
  trainId       Int            @map("train_id")
  routeId       Int            @map("route_id")
  departureTime DateTime       @map("departure_time")
  arrivalTime   DateTime       @map("arrival_time")
  basePrice     Decimal        @map("base_price") @db.Decimal(12, 2)
  status        ScheduleStatus @default(SCHEDULED)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  train    Train     @relation(fields: [trainId], references: [id])
  route    Route     @relation(fields: [routeId], references: [id])
  bookings Booking[]
  tickets  Ticket[]

  @@index([departureTime])
  @@index([routeId])
  @@index([trainId])
  @@map("schedules")
}

model Booking {
  id            Int           @id @default(autoincrement())
  publicId      String        @unique @default(uuid()) @map("public_id")
  bookingCode   String        @unique @map("booking_code")
  userId        Int           @map("user_id")
  scheduleId    Int           @map("schedule_id")
  status        BookingStatus @default(PENDING_PAYMENT)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  holdExpiresAt DateTime      @map("hold_expires_at")
  cancelReason  String?       @map("cancel_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  createdBy     String?       @map("created_by")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  updatedBy     String?       @map("updated_by")
  cancelledAt   DateTime?     @map("cancelled_at")
  expiredAt     DateTime?     @map("expired_at")

  user       User          @relation(fields: [userId], references: [id])
  schedule   Schedule      @relation(fields: [scheduleId], references: [id])
  items      BookingItem[]
  passengers Passenger[]
  payments   Payment[]
  tickets    Ticket[]

  @@index([bookingCode])
  @@index([userId])
  @@index([scheduleId])
  @@index([status])
  @@map("bookings")
}

model BookingItem {
  id          Int               @id @default(autoincrement())
  bookingId   Int               @map("booking_id")
  scheduleId  Int               @map("schedule_id")
  seatId      Int               @map("seat_id")
  passengerId Int?              @map("passenger_id")
  price       Decimal           @db.Decimal(12, 2)
  status      BookingItemStatus @default(HELD)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  booking   Booking    @relation(fields: [bookingId], references: [id])
  seat      Seat       @relation(fields: [seatId], references: [id])
  passenger Passenger? @relation(fields: [passengerId], references: [id])
  tickets   Ticket[]

  @@index([scheduleId, seatId])
  @@index([bookingId])
  @@map("booking_items")
}

model Passenger {
  id             Int           @id @default(autoincrement())
  publicId       String        @unique @default(uuid()) @map("public_id")
  bookingId      Int           @map("booking_id")
  fullName       String        @map("full_name")
  identityType   IdentityType  @map("identity_type")
  identityNumber String        @map("identity_number")
  dateOfBirth    DateTime      @map("date_of_birth") @db.Date
  passengerType  PassengerType @map("passenger_type")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  booking      Booking       @relation(fields: [bookingId], references: [id])
  bookingItems BookingItem[]
  tickets      Ticket[]

  @@index([bookingId])
  @@map("passengers")
}

model Payment {
  id               Int           @id @default(autoincrement())
  publicId         String        @unique @default(uuid()) @map("public_id")
  paymentReference String        @unique @map("payment_reference")
  bookingId        Int           @map("booking_id")
  paymentMethod    PaymentMethod @map("payment_method")
  amount           Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?     @map("paid_at")
  expiredAt        DateTime?     @map("expired_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([paymentReference])
  @@index([bookingId])
  @@map("payments")
}

model Ticket {
  id            Int          @id @default(autoincrement())
  publicId      String       @unique @default(uuid()) @map("public_id")
  ticketNumber  String       @unique @map("ticket_number")
  bookingId     Int          @map("booking_id")
  bookingItemId Int          @map("booking_item_id")
  passengerId   Int          @map("passenger_id")
  scheduleId    Int          @map("schedule_id")
  seatId        Int          @map("seat_id")
  qrCodeValue   String       @unique @map("qr_code_value")
  status        TicketStatus @default(ACTIVE)
  issuedAt      DateTime     @default(now()) @map("issued_at")
  usedAt        DateTime?    @map("used_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  booking     Booking     @relation(fields: [bookingId], references: [id])
  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id])
  passenger   Passenger   @relation(fields: [passengerId], references: [id])
  schedule    Schedule    @relation(fields: [scheduleId], references: [id])
  seat        Seat        @relation(fields: [seatId], references: [id])

  @@index([ticketNumber])
  @@index([bookingId])
  @@map("tickets")
}

model IdempotencyKey {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  requestPath  String   @map("request_path")
  responseBody Json     @map("response_body")
  statusCode   Int      @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([key])
  @@map("idempotency_keys")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique @default(uuid()) @map("public_id")
  userId         Int?     @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityPublicId String?  @map("entity_public_id")
  oldData        Json?    @map("old_data")
  newData        Json?    @map("new_data")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityPublicId])
  @@index([userId])
  @@map("audit_logs")
}
